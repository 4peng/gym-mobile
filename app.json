{
  "expo": {
    "name": "Gym Mobile",
    "slug": "gym-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.svg",
    "scheme": "gym-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.x4peng.myproject",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon.svg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ]
  }
}
