{
  "expo": {
    "name": "Gym Mobile",
    "slug": "gym-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gym-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.x4peng.gym-mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "frequentUpdates": true,
          "widgets": []
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.x4peng.gym-mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.x4peng.gym-mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5ec40e2c-f3ad-438c-8824-e644f8da1f87"
      }
    },
    "owner": "4peng"
  }
}
